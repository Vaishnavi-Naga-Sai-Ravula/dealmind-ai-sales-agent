# Copy to .env at the repository root. Never commit real credentials.
# Leave empty for an honest offline demo; use your actual cloud/self-hosted URL.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=dealmind
HINDSIGHT_TIMEOUT=60
# hindsight uses the LLM configured on your Hindsight service; demo is rules-based.
INTELLIGENCE_MODE=hindsight
DATABASE_PATH=data/dealmind.db
SEED_SAMPLE_DATA=true
FRONTEND_ORIGIN=http://localhost:5173
# The frontend reads frontend/.env.local, not this backend .env.
# Optional there: VITE_API_URL=http://127.0.0.1:8000
# Default is same-origin /api via Vite's backend proxy (recommended locally).
